# Reminder Agent 环境变量模板
# 复制此文件为 .env 并填入真实值

# DeepSeek API（或其他 OpenAI 兼容 API）
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
SERVER_URL=http://localhost:8000

# 微信接入
WECHAT_SECRET=your-wechat-secret

# 飞书接入
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret

# WhatsApp 接入
WHATSAPP_SECRET=your-whatsapp-secret

# LinkedIn 接入
LINKEDIN_EMAIL=your-linkedin-email
LINKEDIN_PASSWORD=your-linkedin-password
LINKEDIN_SECRET=your-linkedin-secret
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# 代理（仅 Docker 容器内需要，可选）
# PROXY_URL=http://host.docker.internal:7897
# BUILD_PROXY=http://172.18.0.1:7897
